@model GestionEmpleadosMVC.Models.Empleado

<h2>Nuevo Empleado</h2>

@using (Html.BeginForm())
{
    <label>Nombre:</label>
    @Html.TextBoxFor(e => e.Nombre)
    <br />
    <br />

    <label>Puesto:</label>
    @Html.TextBoxFor(e => e.Puesto)
    <br />
    <br />

    <input type="submit" value="Guardar" />
}